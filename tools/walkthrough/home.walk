# The home page on its own: the target stepped with nothing running, a run started and given time to
# climb, stopped and vented, then resumed from the target it kept.
#
#   python tools/walkthrough/walk.py tools/walkthrough/home.walk

# The panel's design, which the composition sets once on a device: a leaf that names no family draws
# in it, and the band's height picks the cut.
set-font profont

# The model chamber is left at its own rates, so the target the presses build is a few seconds'
# climb and the reading can be seen to arrive at it rather than appear there.
load home

wait 1 s

# Up six times and Down once: a press moves the target by the panel's whole step, which is one kPa
# while the unit is kPa, and the readout under the title carries the target beside the dashes a
# stopped machine reads. The machine works no shallower than five kPa, so the first press from
# ambient lands there and the five that follow step above it. Each press is marked on the picture for
# the second a send gives it, which is long enough to read the step and short enough not to run into
# the one after it.
set-note increase pressure
send up:single
wait 500ms
send up:single
wait 500ms
send up:single
wait 500ms
send up:single
wait 500ms
send up:single
wait 500ms
send up:single
clear-note

set-note decrease pressure
wait 5 s
send down:single
wait 2 s
clear-note

# OK starts the run: the valve closes, the reading climbs to the target and holds there, and the
# timer beside the pressure counts the run's seconds.
set-note start the pump
send ok:single
clear-note
wait 4 s

# Up while it runs moves the target one step deeper, and the pump follows it without the clock
# restarting.
set-note pump up pressure
send up:single
clear-note
wait 3 s

# Cancel stops the pump and opens the valve: nothing is running, so the reading goes back to dashes
# and the timer goes with the run.
set-note stop and vent
send cancel:single
wait 2 s
clear-note 

# A further OK resumes from the target a press left, and the clock starts again from zero.
set-note start the pump
send ok:single
wait 3 s
clear-note
set-note run for a while
advance 890s
set-note chamber auto-vents
wait 10s
clear-note

emit
